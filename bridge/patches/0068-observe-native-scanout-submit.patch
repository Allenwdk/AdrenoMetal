         hook(45, id, command, batch);
     }
 }
+
+type NativeSubmitCursor = extern "C" fn() -> u64;
+static NATIVE_SUBMIT_CURSOR: std::sync::OnceLock<NativeSubmitCursor> = std::sync::OnceLock::new();
+
+/// Read the driver thread's current native submission sequence and fence.
+/// The observer is optional and may only be installed for this process's driver.
+pub fn set_native_submit_cursor(cursor: NativeSubmitCursor) {
+    let _ = NATIVE_SUBMIT_CURSOR.set(cursor);
+}
+
+pub(crate) fn native_submit_cursor() -> u64 {
+    NATIVE_SUBMIT_CURSOR.get().map_or(0, |cursor| cursor())
+}
+
+/// Both samples straddle the synchronous Vulkan call on the same thread.
+/// A queued or empty submission returning without a new fence stays unknown.
+pub(crate) fn diagnostic_native_submit(id: u64, before: u64) {
+    let after = native_submit_cursor();
+    let sequence = after >> 32;
+    let fence = after as u32;
+    if sequence != 0 && sequence != before >> 32 && fence != 0 {
+        if let Some(hook) = DIAGNOSTIC_HOOK.get() {
+            hook(46, id, u64::from(fence), sequence);
+        }
+    }
+}
